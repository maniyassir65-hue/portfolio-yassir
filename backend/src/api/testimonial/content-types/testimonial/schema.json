{
    "kind": "collectionType",
    "collectionName": "testimonials",
    "info": {
        "singularName": "testimonial",
        "pluralName": "testimonials",
        "displayName": "Testimonial",
        "description": "Client reviews and feedback"
    },
    "options": {
        "draftAndPublish": true
    },
    "attributes": {
        "clientName": {
            "type": "string",
            "required": true
        },
        "clientRole": {
            "type": "string"
        },
        "quote": {
            "type": "text",
            "required": true
        },
        "avatar": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ]
        }
    }
}